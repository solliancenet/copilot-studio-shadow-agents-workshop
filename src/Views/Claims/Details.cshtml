@using MeridianMutual.Models.ViewModels
@model ClaimDetailViewModel
@{
    var claim = Model.Claim;
    var policy = claim.Policy;
    var holder = policy?.Policyholder;
    ViewData["Title"] = $"Claim {claim.ClaimNumber}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Triage queue</a></li>
        <li class="breadcrumb-item active" aria-current="page">@claim.ClaimNumber</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">@claim.ClaimNumber</h1>
        <p class="text-muted mb-0">
            Filed @claim.FiledOn.ToString("d MMMM yyyy") &middot;
            <span class="badge @(claim.Status == MeridianMutual.Models.ClaimStatus.UnderReview ? "text-bg-warning" : "text-bg-secondary")">@claim.Status</span>
        </p>
    </div>
    <div class="text-end">
        <div class="text-muted small text-uppercase">Amount claimed</div>
        <div class="h3 mb-0">@claim.Amount.ToString("C")</div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Claim</h2>
                <p class="mb-0">@claim.Description</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Policy &amp; policyholder</h2>
                @if (policy is not null)
                {
                    <div class="mb-1">
                        <a asp-controller="Policies" asp-action="Details" asp-route-id="@policy.PolicyNumber">@policy.PolicyNumber</a>
                        <span class="text-muted">&middot; @policy.Type &middot; @policy.Status</span>
                    </div>
                    <div class="small mb-2">@holder?.Name @(holder is not null ? $"· member since {holder.MemberSince:MMMM yyyy}" : "")</div>
                    <p class="small mb-0">@policy.CoverageSummary</p>
                }
                else
                {
                    <p class="text-muted mb-0">No policy is linked to this claim.</p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.PriorClaims.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted">Prior claims on this policy</h2>
            <ul class="list-unstyled small mb-0">
                @foreach (var prior in Model.PriorClaims)
                {
                    <li>@prior.ClaimNumber &middot; @prior.FiledOn.ToString("d MMM yyyy") &middot; @prior.Amount.ToString("C") &middot; @prior.Status</li>
                }
            </ul>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-1">Triage briefing</h2>
                <p class="text-muted small mb-0">
                    Generated by the Meridian Mutual Claims-Triage agent. Human review required —
                    the agent does not make a claim decision.
                </p>
            </div>
            <form asp-controller="Claims" asp-action="GenerateBriefing" asp-route-id="@claim.ClaimNumber" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary" @(Model.AgentConfigured ? "" : "disabled")>
                    Generate triage briefing
                </button>
            </form>
        </div>

        @if (!Model.AgentConfigured)
        {
            <div class="alert alert-warning mt-3 mb-0 small">
                The Foundry agent is not configured. Set <code>Foundry:ProjectEndpoint</code>
                (and ensure the app identity has the Foundry User role) to enable briefings.
            </div>
        }

        @if (Model.BriefingError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0 small">@Model.BriefingError</div>
        }

        @if (Model.Briefing is not null)
        {
            <hr />
            @if (Model.Briefing.Steps.Count > 0)
            {
                <section class="triage-trace mb-4" aria-label="Agent audit trail">
                    <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-2">
                        <h3 class="h6 mb-0">What the agent did &amp; why</h3>
                        <span class="small text-muted">
                            @Model.Briefing.Steps.Count step@(Model.Briefing.Steps.Count == 1 ? "" : "s")@(Model.Briefing.CitationCount > 0 ? $" · {Model.Briefing.CitationCount} citation{(Model.Briefing.CitationCount == 1 ? "" : "s")}" : "")
                        </span>
                    </div>

                    <div class="alert alert-secondary small d-flex gap-2 py-2 mb-3" role="note">
                        <span aria-hidden="true">&#128274;</span>
                        <span>
                            Ran as the application's <strong>managed identity</strong> with a
                            <strong>least-privilege, read-only</strong> scope over the claims API and
                            grounding documents. No data was written and no decision was made — a
                            <strong>human adjuster</strong> decides.
                        </span>
                    </div>

                    <ol class="trace-timeline list-unstyled mb-0">
                        @for (var i = 0; i < Model.Briefing.Steps.Count; i++)
                        {
                            var step = Model.Briefing.Steps[i];
                            var icon = step.Kind == "search" ? "&#128218;" : step.Kind == "api" ? "&#128279;" : "&#9881;";
                            <li class="trace-step d-flex gap-3 pb-3">
                                <div class="trace-marker text-center">
                                    <span class="trace-index badge rounded-pill text-bg-primary">@(i + 1)</span>
                                </div>
                                <div class="trace-body">
                                    <div class="fw-semibold">
                                        <span class="me-1" aria-hidden="true">@Html.Raw(icon)</span>@step.Title
                                    </div>
                                    @if (step.Detail is not null)
                                    {
                                        <div class="small text-muted">@step.Detail</div>
                                    }
                                    @if (step.Reference is not null)
                                    {
                                        <div class="small mt-1">
                                            <code class="trace-ref">@step.Reference</code>
                                            @if (step.Status is not null)
                                            {
                                                <span class="badge text-bg-light border ms-1">@step.Status</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                </section>
            }
            <div class="briefing">
                @Html.Raw(Markdig.Markdown.ToHtml(Model.Briefing.Markdown ?? ""))
            </div>
        }
    </div>
</div>
