@model HalcourtMutual.Models.Policy
@{
    ViewData["Title"] = Model.PolicyNumber;
    var payments = ViewData["Payments"] as List<HalcourtMutual.Models.PremiumPayment>
        ?? new List<HalcourtMutual.Models.PremiumPayment>();
    var claims = ViewData["Claims"] as List<HalcourtMutual.Models.Claim>
        ?? new List<HalcourtMutual.Models.Claim>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">My policies</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.PolicyNumber</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Type policy @Model.PolicyNumber</h1>
        <p class="text-muted mb-0">
            @Model.Status &middot; effective @Model.EffectiveDate.ToString("d MMMM yyyy")
            &middot; renews @Model.RenewalDate.ToString("d MMMM yyyy")
        </p>
    </div>
    <div class="text-end">
        <div class="text-muted small text-uppercase">Monthly premium</div>
        <div class="h3 mb-0">@Model.MonthlyPremium.ToString("C")</div>
    </div>
</div>

<h2 class="h5">Coverage</h2>
<p>@Model.CoverageSummary</p>

<h2 class="h5 mt-4">Premium payments</h2>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th scope="col">Paid on</th>
            <th scope="col">Method</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-end">Amount</th>
        </tr>
    </thead>
    <tbody>
    @if (payments.Count == 0)
    {
        <tr><td colspan="4" class="text-muted">No premium payments have been recorded.</td></tr>
    }
    @foreach (var payment in payments)
    {
        <tr>
            <td>@payment.PaidOn.ToString("MMM d, yyyy")</td>
            <td>@payment.Method</td>
            <td>@payment.Status</td>
            <td class="text-end">@payment.Amount.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>

<h2 class="h5 mt-4">Claims</h2>
<ul class="list-group">
@if (claims.Count == 0)
{
    <li class="list-group-item text-muted">No claims have been filed against this policy.</li>
}
@foreach (var claim in claims)
{
    <li class="list-group-item">
        <div class="d-flex justify-content-between align-items-center">
            <span><strong>@claim.ClaimNumber</strong> &middot; filed @claim.FiledOn.ToString("MMM d, yyyy")</span>
            <span class="text-muted">@claim.Status &middot; @claim.Amount.ToString("C")</span>
        </div>
        <div class="small text-muted">@claim.Description</div>
    </li>
}
</ul>
