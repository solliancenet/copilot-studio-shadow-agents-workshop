@model List<MeridianMutual.Models.Claim>
@{
    ViewData["Title"] = "Triage queue";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Triage queue</h1>
        <p class="text-muted mb-0">Claims awaiting adjuster review &mdash; Open and Under review.</p>
    </div>
    <div class="text-end">
        <div class="text-muted small text-uppercase">In queue</div>
        <div class="h3 mb-0">@Model.Count</div>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Nothing is waiting for triage right now.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Claim #</th>
                    <th scope="col">Policyholder</th>
                    <th scope="col">Policy</th>
                    <th scope="col">Type / vehicle</th>
                    <th scope="col">Filed</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    var policy = claim.Policy;
                    <tr>
                        <td class="fw-semibold">@claim.ClaimNumber</td>
                        <td>@(policy?.Policyholder?.Name ?? "—")</td>
                        <td>@(policy?.PolicyNumber ?? "—")</td>
                        <td class="small text-muted">@(policy?.Type.ToString() ?? "—")</td>
                        <td class="small">@claim.FiledOn.ToString("d MMM yyyy")</td>
                        <td class="text-end">@claim.Amount.ToString("C")</td>
                        <td>
                            <span class="badge @(claim.Status == MeridianMutual.Models.ClaimStatus.UnderReview ? "text-bg-warning" : "text-bg-secondary")">
                                @claim.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimNumber">
                                Open
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
