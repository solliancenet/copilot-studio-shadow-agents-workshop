@model List<MeridianMutual.Models.Policy>
@{
    ViewData["Title"] = "My policies";
    var member = ViewData["Member"] as MeridianMutual.Models.Policyholder;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">My policies</h1>
        @if (member is not null)
        {
            <p class="text-muted mb-0">
                @member.Name &middot; member since @member.MemberSince.ToString("MMMM yyyy")
            </p>
        }
    </div>
    <div class="text-end">
        <div class="text-muted small text-uppercase">Total monthly premium</div>
        <div class="h3 mb-0">@Model.Sum(p => p.MonthlyPremium).ToString("C")</div>
    </div>
</div>

<div class="row g-3">
    @foreach (var policy in Model)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">@policy.Type</div>
                    <h2 class="h5 card-title mb-1">@policy.PolicyNumber</h2>
                    <p class="text-muted small mb-3">
                        @policy.Status &middot; renews @policy.RenewalDate.ToString("d MMMM yyyy")
                    </p>
                    <div class="h4 mb-3">@policy.MonthlyPremium.ToString("C") <span class="text-muted h6">/ month</span></div>
                    <p class="small">@policy.CoverageSummary</p>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Policies" asp-action="Details" asp-route-id="@policy.PolicyNumber">
                        View policy
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No policies are on file for this member.</p>
}
