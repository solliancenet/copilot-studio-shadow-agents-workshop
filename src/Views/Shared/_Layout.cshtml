<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Halcourt Mutual Claims Triage Console</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2312294B'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23178C82' stroke-width='2'/%3E%3Cpath d='M7 16a9 9 0 0 1 18 0' fill='none' stroke='%23ffffff' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='16' r='1.9' fill='%23178C82'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HalcourtMutual.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mm-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand mm-brand-lockup" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Halcourt Mutual — Claims Triage Console home">
                    <svg class="mm-logo" viewBox="0 0 210 40" role="img" aria-label="Halcourt Mutual" xmlns="http://www.w3.org/2000/svg">
                        <g fill="none">
                            <circle cx="20" cy="20" r="15" stroke="#178C82" stroke-width="2.4"/>
                            <path d="M5 20a15 15 0 0 1 30 0" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round"/>
                            <line x1="20" y1="5" x2="20" y2="35" stroke="#4E6E9E" stroke-width="1.4"/>
                            <circle cx="20" cy="20" r="3" fill="#178C82"/>
                        </g>
                        <text x="48" y="20" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="17" font-weight="700" letter-spacing="-0.2" fill="#FFFFFF">Halcourt</text>
                        <text x="129" y="20" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="17" font-weight="400" letter-spacing="-0.2" fill="#A9C2E4">Mutual</text>
                        <text x="48" y="33" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="7.5" font-weight="600" letter-spacing="1.6" fill="#178C82">INSURANCE</text>
                    </svg>
                    <span class="mm-brand-divider" aria-hidden="true"></span>
                    <span class="mm-brand-context">
                        <span class="mm-app-name">Claims Triage Console</span>
                        <span class="mm-app-scope">Adjusters</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-sm-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Triage queue</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger">Member API</a>
                        </li>
                    </ul>
                    <span class="navbar-text small">Internal &middot; Adjusters only</span>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Halcourt Mutual Insurance - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
